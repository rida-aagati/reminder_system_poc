# TalentSkout Voice Agent Environment Variables
# =============================================

# Speech Engine (Required for Voice & Transcription)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# LLM Streaming Engine (Provide ANY ONE of the following for real cloud LLM streaming!):
# 1. Groq (Recommended for real-time voice — ultra-fast sub-100ms streaming!)
GROQ_API_KEY=your_groq_api_key_here

# 2. Anthropic (Claude 3.5 Sonnet / Haiku)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 3. OpenAI (GPT-4o-mini / GPT-4o)
# OPENAI_API_KEY=your_openai_api_key_here

# 4. Google Gemini (Gemini 2.0 Flash / 1.5 Flash)
# GEMINI_API_KEY=your_gemini_api_key_here
